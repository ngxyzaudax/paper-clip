Screen {
    layout: vertical;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

MainScreen {
    overflow: hidden;
}

Button {
    min-width: 4;
}

Header {
    height: 1;
}

Footer {
    height: 1;
}

#app-layout {
    width: 100%;
    height: 1fr;
}

#sidebar {
    width: 15;
    height: 100%;
    background: $surface;
    border-right: tall $surface-lighten-2;
}

#sidebar.collapsed {
    width: 6;
}

#sidebar-brand {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 0;
}

#sidebar-nav {
    height: 1fr;
    width: 100%;
}

.nav-group {
    width: 100%;
    text-style: bold;
    color: $text-muted;
    padding: 0 0 0 0;
}

.nav-btn {
    width: 100%;
    margin: 0;
    min-width: 4;
    border: none;
}

.nav-btn:hover {
    background: $surface-lighten-1;
}

.nav-btn.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#sidebar-status {
    width: 100%;
    padding: 0;
    color: $text-muted;
}

#sidebar-toggle {
    width: 100%;
    margin: 0;
    min-width: 4;
}

#nav-quit {
    width: 100%;
    margin: 0;
}

#content-area {
    width: 1fr;
    height: 100%;
}

EncodeScreen,
DevicesScreen {
    width: 100%;
    height: 100%;
}

.encode-screen-layout {
    width: 100%;
    height: 100%;
    layout: vertical;
}

.encode-action-btn {
    min-width: 10;
    padding: 0 1;
    margin: 0;
}

.encode-split {
    width: 100%;
    height: 1fr;
    min-height: 6;
    layout: horizontal;
}

.encode-form-col {
    width: 1fr;
    min-width: 36;
    height: 100%;
    min-height: 0;
    layout: vertical;
}

.encode-form-col > .section {
    width: 100%;
    height: 1fr;
    min-height: 0;
    layout: vertical;
}

.encode-form-scroll {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

.encode-panel-title {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $accent;
    text-opacity: 100%;
    margin-bottom: 0;
}

.encode-info-col {
    width: 1fr;
    min-width: 36;
    height: 100%;
    min-height: 0;
    layout: vertical;
}

.encode-info-col > .section {
    width: 100%;
    height: 1fr;
    layout: vertical;
    min-height: 0;
}

.encode-info-scroll {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#encode-info-display {
    width: 100%;
    height: auto;
}

.encode-bottom-scroll {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

.screen-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $accent;
    padding: 0;
    margin-bottom: 0;
    height: auto;
}

.form-container {
    width: 100%;
    height: 100%;
    padding: 0;
}

.section {
    width: 100%;
    height: auto;
    border: tall $surface-lighten-2;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

.section-title {
    width: 100%;
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
    text-opacity: 100%;
}

Label {
    margin-top: 0;
    margin-bottom: 0;
    text-style: none;
    color: $text;
    text-opacity: 88%;
}

.encode-input-section Label {
    text-opacity: 100%;
}

.encode-input-section {
    padding: 0;
}

.encode-password-block {
    width: 100%;
    height: auto;
    margin-top: 0;
}

.encode-password-block Input {
    width: 100%;
}

Input {
    margin: 0;
    height: 1;
    padding: 0 1;
    scrollbar-size-horizontal: 0;
}

Select {
    margin: 0;
    height: auto;
}

Select > SelectCurrent {
    padding: 0 1;
}

.form-row {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.form-col {
    width: 1fr;
    height: auto;
    padding: 0;
}

.form-col:last-child {
    padding: 0;
}

.details-panel {
    padding: 0;
    margin: 0;
    background: $surface;
    min-height: 1;
}

.button-bar {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 0;
}

.button-bar Button {
    margin: 0;
    min-width: 8;
}

.button-bar .encode-action-btn {
    min-width: 10;
}

ProgressBar {
    margin: 0;
}

#status {
    width: 100%;
    content-align: center middle;
    min-height: 1;
    padding: 0;
}

.note {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
    margin-bottom: 0;
}

.picker-row {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin: 0;
    padding: 0 1 0 0;
}

.picker-row Input {
    width: 1fr;
    margin: 0;
}

.picker-row Static {
    width: 1fr;
    height: auto;
    padding: 0;
    content-align: left middle;
}

.picker-row Button {
    min-width: 10;
    margin-left: 1;
}

#picker-modal {
    width: 80%;
    height: 80%;
    max-width: 100;
    background: $surface;
    border: tall $accent;
    padding: 0;
}

#picker-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $accent;
    margin-bottom: 0;
}

#picker-selection {
    width: 100%;
    padding: 0;
    margin-bottom: 0;
    color: $text;
}

#picker-tree {
    width: 100%;
    height: 1fr;
    margin-bottom: 0;
}

#picker-buttons {
    width: 100%;
    height: auto;
    align: center middle;
}

#picker-buttons Button {
    margin: 0;
    min-width: 10;
}

Checkbox {
    margin: 0;
}
